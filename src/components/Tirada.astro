---
// Tirada de varias cartas: pregunta opcional, abanico para elegir y lectura por posiciones.
import Carta from './Carta.astro';
import SelectorBaraja from './SelectorBaraja.astro';
import { arcanos } from '../data/arcanos';
import { lecturas, type Lectura } from '../data/lecturas';

interface Posicion {
  clave: keyof Lectura;
  titulo: string;
}

interface Props {
  posiciones: Posicion[];
  preguntas?: string[];
  placeholder?: string;
  cierre?: string;
  /** Si se indica, la última carta muestra una respuesta de sí, no o quizás tomada de este campo. */
  respuesta?: 'exRespuesta';
  /** «fila» pone cada carta con su texto debajo; «cruz» coloca las diez cartas de la cruz celta y los textos aparte. */
  disposicion?: 'fila' | 'cruz';
}

const { posiciones, preguntas = [], placeholder = '¿Qué necesito saber?', cierre = 'Para llevarte', respuesta, disposicion = 'fila' } = Astro.props;
const cruz = disposicion === 'cruz';
const numeros: Record<number, string> = { 1: 'una carta', 3: 'tres cartas', 10: 'diez cartas' };
const n = posiciones.length;

const datos = arcanos.map((a) => ({
  slug: a.slug,
  romano: a.romano,
  nombre: a.nombre,
  consejo: a.consejo,
  textos: Object.fromEntries(posiciones.map((p) => [p.clave, lecturas[a.slug][p.clave]])),
  respuesta: respuesta ? lecturas[a.slug][respuesta] : null,
}));
---

<section class="mesa">
  <div class="contenedor">
    <div class="paso" id="paso-pregunta">
      <slot />
      <form class="formulario" id="formulario">
        <label for="pregunta">Tu pregunta <span class="suave">(opcional, solo queda en tu navegador)</span></label>
        <div class="campo">
          <input id="pregunta" type="text" maxlength="140" placeholder={placeholder} autocomplete="off" />
          <button class="boton" type="submit">Barajar</button>
        </div>
        {
          preguntas.length > 0 && (
            <div class="sugerencias">
              {preguntas.map((p) => (
                <button type="button" class="sugerencia">
                  {p}
                </button>
              ))}
            </div>
          )
        }
      </form>
      <div class="elegir-baraja"><SelectorBaraja /></div>
    </div>

    <div class="paso oculto" id="paso-elegir" aria-live="polite">
      <p class="instruccion">Elige {numeros[n] ?? `${n} cartas`}, sin pensarlo mucho</p>
      <ol class:list={['huecos', { compactos: cruz }]} id="huecos">
        {posiciones.map((p, i) => <li><span class="hueco" /><span class="hueco-titulo">{cruz ? i + 1 : p.titulo}</span></li>)}
      </ol>
      <div class="abanico" id="abanico"></div>
    </div>

    <div class="paso oculto" id="paso-resultado" aria-live="polite">
      <p class="tu-pregunta" id="tu-pregunta"></p>
      <p class="aviso-repetida" id="aviso" hidden></p>
      {
        cruz ? (
          <>
            <ol class="lectura-cruz" id="lectura" aria-label="Las diez cartas en cruz">
              {posiciones.map((p, i) => (
                <li class="posicion" data-pos={i + 1} style={`--i:${i}`}>
                  <span class="numero" aria-hidden="true">{i + 1}</span>
                  <div class="giro">
                    <div class="cara dorso" />
                    <div class="cara frente" />
                  </div>
                </li>
              ))}
            </ol>
            <ol class="textos-cruz" id="textos">
              {posiciones.map((p, i) => (
                <li class="explicacion" style={`--i:${i}`}>
                  <span class="numero">{i + 1}</span>
                  <div>
                    <p class="antetitulo">{p.titulo}</p>
                    <a class="carta-titulo" href="/cartas/" />
                    <p class="texto" />
                  </div>
                </li>
              ))}
            </ol>
          </>
        ) : (
      <ol class="lectura" id="lectura" style={`--n:${n}`}>
        {
          posiciones.map((p, i) => (
            <li class="posicion" style={`--i:${i}`}>
              <p class="antetitulo">{p.titulo}</p>
              <div class="giro">
                <div class="cara dorso" />
                <div class="cara frente" />
              </div>
              <div class="explicacion">
                {i === n - 1 && respuesta && <p class="veredicto" />}
                <a class="carta-titulo" href="/cartas/" />
                <p class="texto" />
              </div>
            </li>
          ))
        }
      </ol>
        )
      }
      <div class="final">
        <p class="consejo"><span>{cierre}</span> <span id="consejo"></span></p>
        <div class="acciones">
          <button class="boton" id="otra" type="button">Preguntar otra cosa</button>
          <a class="enlace-flecha" href="/tiradas/">Ver todas las tiradas</a>
        </div>
        <p class="nota">Las cartas recuerdan lo que les preguntas. Si repites la misma pregunta hoy, te darán la misma respuesta.</p>
      </div>
    </div>
  </div>
</section>

{arcanos.map((a) => <template id={`carta-${a.slug}`}><Carta arcano={a} /></template>)}

<script is:inline define:vars={{ datos, n }}>
  const $ = (id) => document.getElementById(id);
  const pasos = ['paso-pregunta', 'paso-elegir', 'paso-resultado'].map($);
  const abanico = $('abanico');
  const huecos = [...$('huecos').children];
  const posiciones = [...$('lectura').children];
  const textos = $('textos') ? [...$('textos').children] : posiciones;
  const input = $('pregunta');
  const total = n > 3 ? 18 : 12;
  let elegidas = [];

  const azar = (max) => {
    const u = new Uint32Array(1);
    crypto.getRandomValues(u);
    return u[0] % max;
  };

  const barajar = (lista) => {
    const copia = [...lista];
    for (let i = copia.length - 1; i > 0; i--) {
      const j = azar(i + 1);
      [copia[i], copia[j]] = [copia[j], copia[i]];
    }
    return copia;
  };

  const mostrar = (paso) => {
    pasos.forEach((p) => p.classList.add('oculto'));
    paso.classList.remove('oculto');
    paso.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  document.querySelectorAll('.sugerencia').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.textContent.trim();
      input.focus();
    }),
  );

  const repartir = () => {
    elegidas = [];
    huecos.forEach((h) => h.classList.remove('lleno'));
    const mazo = barajar(datos).slice(0, total);
    abanico.innerHTML = '';
    abanico.classList.toggle('muchas', total > 12);
    mazo.forEach((carta, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'dorso elegible';
      b.style.setProperty('--i', i);
      b.style.setProperty('--giro', `${((i - (total - 1) / 2) * 60) / (total - 1)}deg`);
      b.setAttribute('aria-label', `Carta ${i + 1} de ${total}`);
      b.addEventListener('click', () => tomar(b, carta));
      abanico.appendChild(b);
    });
    mostrar(pasos[1]);
  };

  const tomar = (boton, carta) => {
    if (elegidas.length >= n) return;
    boton.disabled = true;
    boton.classList.add('tomada');
    huecos[elegidas.length].classList.add('lleno');
    elegidas.push(carta);
    if (elegidas.length === n) {
      window.memoriaTirada?.guardar(location.pathname, input.value, elegidas.map((c) => c.slug));
      setTimeout(() => revelar(false), 650);
    }
  };

  const revelar = (repetida) => {
    const pregunta = input.value.trim();
    $('tu-pregunta').textContent = pregunta ? `«${pregunta}»` : '';
    const aviso = $('aviso');
    aviso.hidden = !repetida;
    aviso.textContent = pregunta
      ? 'Ya les hiciste esta pregunta a las cartas hoy. Esta fue su respuesta, y sigue siendo la misma.'
      : 'Acabas de hacer esta tirada. Esta fue tu lectura. Si tienes otra pregunta, escríbela y vuelve a barajar.';
    posiciones.forEach((li, i) => {
      const carta = elegidas[i];
      const clave = Object.keys(carta.textos)[i];
      const bloque = textos[i];
      li.querySelector('.frente').replaceChildren($(`carta-${carta.slug}`).content.cloneNode(true));
      const titulo = bloque.querySelector('.carta-titulo');
      titulo.textContent = `${carta.romano}. ${carta.nombre}`;
      titulo.href = `/cartas/${carta.slug}/`;
      bloque.querySelector('.texto').textContent = carta.textos[clave];
      const veredicto = bloque.querySelector('.veredicto');
      if (veredicto && carta.respuesta) {
        veredicto.textContent = carta.respuesta;
        veredicto.dataset.tipo = carta.respuesta === 'Sí' ? 'si' : carta.respuesta === 'No' ? 'no' : 'quizas';
      }
      li.querySelector('.giro').classList.remove('girada');
      li.classList.remove('vista');
      bloque.classList.remove('vista');
    });
    $('consejo').textContent = elegidas[n - 1].consejo;
    mostrar(pasos[2]);
    posiciones.forEach((li, i) =>
      setTimeout(() => {
        li.querySelector('.giro').classList.add('girada');
        li.classList.add('vista');
        textos[i].classList.add('vista');
      }, 400 + i * (n > 3 ? 280 : 550)),
    );
  };

  $('formulario').addEventListener('submit', (e) => {
    e.preventDefault();
    const previa = window.memoriaTirada?.leer(location.pathname, input.value);
    const cartas = previa?.cartas.map((slug) => datos.find((d) => d.slug === slug));
    if (cartas && cartas.length === n && cartas.every(Boolean)) {
      elegidas = cartas;
      revelar(true);
    } else {
      repartir();
    }
  });
  $('otra').addEventListener('click', () => {
    input.value = '';
    mostrar(pasos[0]);
  });
</script>

<style>
  .mesa {
    padding: 72px 0 96px;
    min-height: calc(100dvh - 68px);
    background: radial-gradient(70% 60% at 50% 30%, rgba(77, 42, 96, 0.55), transparent 70%);
  }
  .paso { scroll-margin-top: 96px; }
  .oculto { display: none; }

  #paso-pregunta { max-width: 640px; }
  #paso-pregunta :global(.sub) { font-size: 1.15rem; color: var(--texto-suave); margin-bottom: 40px; }
  label { display: block; font-size: 0.95rem; margin-bottom: 10px; }
  .campo {
    display: flex;
    gap: 8px;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 6px;
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.3s;
  }
  .campo:focus-within { border-color: var(--oro); }
  #pregunta {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: var(--texto);
    font: inherit;
    font-size: 1.05rem;
    padding: 10px 12px;
  }
  #pregunta::placeholder { color: #8f7f99; }
  #pregunta:focus { outline: none; }
  .sugerencias { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 18px; }
  .sugerencia {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 0.92rem;
    color: var(--texto-suave);
    border-bottom: 1px dotted var(--linea);
    cursor: pointer;
  }
  .sugerencia:hover { color: var(--oro-claro); }
  .elegir-baraja { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--linea-suave); }

  .instruccion { font-family: var(--serif); font-style: italic; font-size: 2rem; text-align: center; margin: 0; }
  .huecos {
    list-style: none;
    padding: 0;
    margin: 28px auto 0;
    display: flex;
    justify-content: center;
    gap: 28px;
  }
  .huecos li { display: grid; justify-items: center; gap: 8px; }
  .hueco {
    width: 44px;
    aspect-ratio: 7 / 12;
    border: 1px dashed var(--linea);
    border-radius: var(--radio);
    transition: background 0.4s, border-color 0.4s;
  }
  .lleno .hueco { border: 1px solid var(--oro); background: var(--c-dorso, #241130); box-shadow: inset 0 0 0 3px rgba(201, 164, 92, 0.25); }
  .hueco-titulo { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--texto-suave); }
  .lleno .hueco-titulo { color: var(--oro-claro); }

  .abanico {
    position: relative;
    height: 400px;
    max-width: 960px;
    margin: 8px auto 0;
  }
  .abanico :global(.elegible) {
    position: absolute;
    width: 140px;
    left: calc(50% - 70px);
    bottom: 10px;
    padding: 0;
    cursor: pointer;
    transform-origin: 50% 260%;
    transform: rotate(var(--giro));
    transition: transform 0.5s var(--ease), border-color 0.3s, opacity 0.5s;
  }
  .abanico :global(.elegible:not(:disabled):hover),
  .abanico :global(.elegible:focus-visible) {
    transform: rotate(var(--giro)) translateY(-26px);
    border-color: var(--oro-claro);
    outline: none;
  }
  .abanico :global(.elegible.tomada) {
    transform: rotate(var(--giro)) translateY(-90px);
    opacity: 0;
    cursor: default;
  }
  @media (prefers-reduced-motion: no-preference) {
    .abanico :global(.elegible) { animation: repartir 0.7s calc(var(--i) * 45ms) var(--ease) both; }
  }
  @keyframes repartir { from { opacity: 0; transform: rotate(0deg) translateY(40px); } }
  @media (max-width: 640px) {
    .instruccion { font-size: 1.6rem; }
    .huecos { gap: 16px; }
    .abanico {
      height: auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      max-width: 340px;
      margin-top: 28px;
    }
    .abanico.muchas { grid-template-columns: repeat(6, 1fr); gap: 8px; max-width: 360px; }
    .paso .huecos.compactos { gap: 6px; flex-wrap: nowrap; }
    .paso .huecos.compactos .hueco { width: 24px; }
    .paso .huecos.compactos .hueco-titulo { font-size: 0.7rem; }
    .abanico :global(.elegible) { position: relative; width: 100%; left: auto; bottom: auto; transform: none; }
    .abanico :global(.elegible:not(:disabled):hover) { transform: translateY(-6px); }
    .abanico :global(.elegible.tomada) { transform: translateY(-12px); opacity: 0.15; }
    @keyframes repartir { from { opacity: 0; transform: translateY(20px); } }
  }

  .tu-pregunta { font-family: var(--serif); font-style: italic; font-size: 1.4rem; color: var(--texto-suave); text-align: center; margin: 0 0 8px; }
  .lectura {
    list-style: none;
    padding: 0;
    margin: 24px auto 0;
    max-width: 1080px;
    display: grid;
    grid-template-columns: repeat(var(--n, 3), 1fr);
    gap: 48px;
  }
  .posicion { display: grid; justify-items: center; align-content: start; text-align: center; }
  .posicion .antetitulo { margin-bottom: 18px; }
  .giro {
    width: 210px;
    aspect-ratio: 7 / 12;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 1s var(--ease);
  }
  .giro.girada { transform: rotateY(180deg); }
  .cara { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .frente { transform: rotateY(180deg); }
  .frente :global(.carta) { max-width: none; height: 100%; }
  .explicacion { margin-top: 26px; max-width: 34ch; }
  .carta-titulo {
    display: inline-block;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--oro);
    text-decoration: none;
    margin-bottom: 12px;
  }
  .carta-titulo:hover { color: var(--oro-claro); }
  .texto { font-size: 1.05rem; margin: 0; }
  .veredicto { font-family: var(--serif); font-size: 3.4rem; line-height: 1; margin: 0 0 10px; color: var(--veredicto, var(--oro-claro)); }
  .explicacion { opacity: 0; transform: translateY(12px); transition: opacity 0.8s 0.5s var(--ease), transform 0.8s 0.5s var(--ease); }
  .vista .explicacion,
  .explicacion.vista { opacity: 1; transform: none; }

  /* Cruz celta: la cruz de seis cartas a la izquierda y el bastón de cuatro a la derecha. */
  .huecos.compactos { gap: 10px; flex-wrap: wrap; }
  .huecos.compactos .hueco { width: 30px; }
  .lectura-cruz {
    --w: 112px;
    --h: calc(var(--w) * 12 / 7);
    list-style: none;
    padding: 0;
    margin: 32px auto 0;
    width: max-content;
    display: grid;
    grid-template-columns: repeat(3, var(--w)) var(--w);
    grid-template-rows: repeat(12, calc(var(--h) / 3));
    column-gap: calc(var(--w) * 0.42);
    row-gap: 6px;
  }
  .lectura-cruz .posicion { position: relative; display: grid; place-items: center; align-content: center; }
  .lectura-cruz .giro { width: var(--w); }
  .lectura-cruz [data-pos='1'] { grid-area: 5 / 2 / 9 / 3; }
  .lectura-cruz [data-pos='2'] { grid-area: 5 / 2 / 9 / 3; z-index: 2; transform: rotate(90deg); }
  .lectura-cruz [data-pos='3'] { grid-area: 9 / 2 / 13 / 3; }
  .lectura-cruz [data-pos='4'] { grid-area: 5 / 1 / 9 / 2; }
  .lectura-cruz [data-pos='5'] { grid-area: 1 / 2 / 5 / 3; }
  .lectura-cruz [data-pos='6'] { grid-area: 5 / 3 / 9 / 4; }
  .lectura-cruz [data-pos='7'] { grid-area: 10 / 4 / 13 / 5; margin-left: calc(var(--w) * 0.35); }
  .lectura-cruz [data-pos='8'] { grid-area: 7 / 4 / 10 / 5; margin-left: calc(var(--w) * 0.35); }
  .lectura-cruz [data-pos='9'] { grid-area: 4 / 4 / 7 / 5; margin-left: calc(var(--w) * 0.35); }
  .lectura-cruz [data-pos='10'] { grid-area: 1 / 4 / 4 / 5; margin-left: calc(var(--w) * 0.35); }
  .numero {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--oro);
    background: var(--noche);
    color: var(--oro-claro);
    font-family: var(--serif);
    font-size: 0.95rem;
    flex: none;
  }
  .lectura-cruz .numero { position: absolute; top: 50%; left: 50%; translate: calc(var(--w) / -2 - 10px) calc(var(--h) / -2 - 10px); z-index: 3; }
  .lectura-cruz [data-pos='2'] .numero { translate: calc(var(--w) / 2 - 16px) calc(var(--h) / -2 - 10px); rotate: -90deg; }
  .textos-cruz {
    list-style: none;
    padding: 0;
    margin: 72px auto 0;
    max-width: 1000px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px 56px;
  }
  .textos-cruz .explicacion { display: flex; gap: 18px; margin: 0; max-width: none; transition-delay: 0.2s; }
  .textos-cruz .antetitulo { margin: 2px 0 6px; }
  .textos-cruz .carta-titulo { margin-bottom: 8px; }
  @media (max-width: 820px) {
    .lectura-cruz { --w: 58px; column-gap: 22px; row-gap: 4px; }
    .lectura-cruz .numero, .textos-cruz .numero { width: 22px; height: 22px; font-size: 0.8rem; }
    .textos-cruz { grid-template-columns: 1fr; margin-top: 48px; gap: 28px; }
  }

  .final {
    max-width: 640px;
    margin: 64px auto 0;
    padding-top: 36px;
    border-top: 1px solid var(--linea-suave);
    text-align: center;
  }
  .consejo { font-family: var(--serif); font-style: italic; font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; margin: 0; }
  .consejo span:first-child {
    display: block;
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--oro);
    margin-bottom: 12px;
  }
  .acciones { display: flex; align-items: center; justify-content: center; gap: 28px; flex-wrap: wrap; margin-top: 36px; }
  .nota { font-size: 0.9rem; color: var(--texto-suave); margin: 20px auto 0; max-width: 46ch; }
  .aviso-repetida {
    max-width: 560px;
    margin: 8px auto 0;
    padding: 12px 18px;
    border: 1px solid color-mix(in srgb, var(--oro) 45%, transparent);
    border-radius: var(--radio);
    text-align: center;
    color: var(--oro-claro);
  }
  @media (prefers-reduced-motion: reduce) {
    .giro { transition: none; }
    .explicacion { transition: none; }
  }
  @media (max-width: 820px) {
    .mesa { padding: 40px 0 64px; }
    .lectura { grid-template-columns: 1fr; gap: 56px; }
    .giro { width: 180px; }
  }
</style>
