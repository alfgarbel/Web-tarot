---
import type { Arcano } from '../data/arcanos';
import { motivos } from '../data/motivos';

interface Props {
  arcano: Arcano;
  tamano?: 'normal' | 'pequena';
}

const { arcano, tamano = 'normal' } = Astro.props;

// Rayos del sol que hay detrás del medallón, alternando largo y corto.
let rayos = '';
for (let i = 0; i < 48; i++) {
  const a = ((Math.PI * 2) / 48) * i;
  const r2 = i % 2 === 0 ? 52 : 46;
  rayos += `M${(70 + 41 * Math.cos(a)).toFixed(2)} ${(116 + 41 * Math.sin(a)).toFixed(2)}L${(70 + r2 * Math.cos(a)).toFixed(2)} ${(116 + r2 * Math.sin(a)).toFixed(2)}`;
}
---

<div class:list={['carta', tamano === 'pequena' && 'carta-pequena', arcano.sinImagen && 'sin-imagen']} role="img" aria-label={`${arcano.romano}. ${arcano.nombre}`}>
  <svg class="carta-arte" viewBox="0 0 140 240" aria-hidden="true">
    <rect class="marco" x="1" y="1" width="138" height="238" rx="5" />
    <path class="marco fino" d="M15 8 H125 L132 15 V225 L125 232 H15 L8 225 V15 Z" />
    <path class="oro" d="M8 15 l4 -4 l3 3 M132 15 l-4 -4 l-3 3 M8 225 l4 4 l3 -3 M132 225 l-4 4 l-3 -3" />
    <path class="marco fino" d="M20 26 H44 M96 26 H120" />
    <circle class="relleno" cx="20" cy="26" r="1.2" /><circle class="relleno" cx="120" cy="26" r="1.2" />
    <g class="adorno">
    <path class="arco" d="M24 180 V100 A46 46 0 0 1 116 100 V180" />
    <path class="rayos" d={rayos} />
    <circle class="marco" cx="70" cy="116" r="38" />
    <circle class="marco fino" cx="70" cy="116" r="35" />
    <g class="motivo" transform="translate(38 84) scale(0.64)" set:html={arcano.motivo ?? motivos[arcano.slug]} />
    <path class="relleno" d="M32 72 l1 3 l3 1 l-3 1 l-1 3 l-1 -3 l-3 -1 l3 -1 Z M108 72 l1 3 l3 1 l-3 1 l-1 3 l-1 -3 l-3 -1 l3 -1 Z M70 47 l.8 2.2 l2.2 .8 l-2.2 .8 l-.8 2.2 l-.8 -2.2 l-2.2 -.8 l2.2 -.8 Z" />
    <circle class="relleno" cx="32" cy="166" r=".9" /><circle class="relleno" cx="108" cy="166" r=".9" /><circle class="relleno" cx="30" cy="150" r=".6" /><circle class="relleno" cx="110" cy="150" r=".6" />
    </g>
    <path class="marco" d="M16 180 H124" />
    <path class="relleno" d="M70 176 L74 180 L70 184 L66 180 Z" />
    <path class="marco fino" d="M16 184 H124" />
  </svg>
  {!arcano.sinImagen && <img class="carta-imagen" src={`/barajas/ilustrada/${arcano.slug}.webp`} alt="" loading="lazy" decoding="async" width="480" height="600" />}
  <span class:list={['carta-numero', arcano.romano.length > 5 && 'largo']}>{arcano.romano}</span>
  <span class="carta-nombre">{arcano.nombre}</span>
</div>
