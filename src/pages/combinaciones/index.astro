---
import Base from '../../layouts/Base.astro';
import Explicacion from '../../components/Explicacion.astro';
import { arcanos } from '../../data/arcanos';
import { combinaciones, slugCombinacion } from '../../data/combinaciones';

const nombre = (slug: string) => arcanos.find((a) => a.slug === slug)!.nombre;
const lista = combinaciones.map((c) => ({ href: `/combinaciones/${slugCombinacion(c)}/`, a: nombre(c.a), b: nombre(c.b), claves: c.claves.join(', ') }));

const faq = [
  {
    p: '¿Cómo se lee una combinación de dos cartas?',
    r: 'Primero lee cada carta por separado. Luego mira en qué coinciden y en qué chocan. Una carta suave calma a una dura, y una dura le mete prisa a una suave. De ese tira y afloja sale el significado de las dos juntas.',
  },
  {
    p: '¿Importa el orden en que salen?',
    r: 'En una tirada con posiciones, sí, porque la carta del pasado pesa distinto que la del futuro. Aquí tienes el sentido general de la pareja. Después ajústalo según dónde cayó cada una.',
  },
  {
    p: '¿Por qué solo hay arcanos mayores?',
    r: 'Porque son las parejas que más se buscan y las que salen en nuestras tiradas. Con los arcanos menores, lee la ficha de cada carta y haz lo mismo.',
  },
];
---

<Base
  title="Combinaciones de cartas del tarot | Arcanaia"
  description={`Significado de las ${combinaciones.length} combinaciones de arcanos mayores más consultadas: qué dicen juntas en el amor y el trabajo, con un consejo para cada pareja.`}
>
  <section class="cabeza contenedor">
    <h1>Combinaciones <em>de cartas</em></h1>
    <p class="sub">Dos cartas juntas se cuentan cosas entre ellas. Aquí tienes las parejas de arcanos mayores que más se consultan y lo que dicen cuando salen a la vez.</p>
  </section>

  <section class="contenedor zona">
    <ul class="lista">
      {
        lista.map((c) => (
          <li>
            <a href={c.href}>
              <span class="nombre">{c.a} <em>y</em> {c.b}</span>
              <span class="claves">{c.claves}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Explicacion titulo="Cómo leer dos cartas juntas" faq={faq}>
    <p>En una tirada, unas cartas tiñen a otras. La Torre al lado de La Estrella sigue siendo un golpe, pero uno que deja sitio a la esperanza. El Sol con La Luna es algo que empieza a aclararse.</p>
    <p>Si te salen dos cartas y no sabes cómo juntarlas, busca aquí su combinación y luego vuelve a la <a href="/cartas/">ficha de cada una</a> para leerla en su posición.</p>
  </Explicacion>
</Base>

<style>
  .cabeza { padding-top: 72px; padding-bottom: 40px; }
  .sub { font-size: 1.2rem; color: var(--texto-suave); max-width: 58ch; }
  .zona { padding-bottom: 96px; }
  .lista { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 40px; }
  .lista a { display: grid; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--linea-suave); text-decoration: none; color: var(--texto); }
  .nombre { font-family: var(--serif); font-size: 1.2rem; }
  .nombre em { color: var(--oro); }
  .claves { font-size: 0.88rem; color: var(--texto-suave); }
  .lista a:hover .nombre { color: var(--oro-claro); }
  @media (max-width: 960px) { .lista { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .lista { grid-template-columns: 1fr; } }
</style>
