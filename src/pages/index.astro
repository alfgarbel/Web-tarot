---
import Base from '../layouts/Base.astro';
import Carta from '../components/Carta.astro';
import { arcanos } from '../data/arcanos';

const destacadas = ['los-enamorados', 'la-estrella', 'la-luna', 'el-sol']
  .map((s) => arcanos.find((a) => a.slug === s)!)
  .filter(Boolean);
---

<Base
  title="El Tarot de Aurora: tiradas de tarot gratis y significado de las cartas"
  description="Tiradas de tarot gratis explicadas con calma. Pregunta al tarot Sí o No, descubre el significado de cada carta y encuentra claridad en el amor, el trabajo y la vida."
>
  <section class="portada">
    <div class="contenedor">
      <div class="portada-texto">
        <span class="etiqueta">Tarot gratis · sin registro</span>
        <h1>Las cartas no deciden por ti. Te ayudan a ver con claridad.</h1>
        <p>
          Tiradas de tarot gratuitas con interpretaciones escritas con cuidado, para el amor, el trabajo y esos días en
          los que necesitas una respuesta.
        </p>
        <div class="botones">
          <a href="/tarot-si-o-no/" class="boton dorado">Preguntar al tarot Sí o No</a>
          <a href="/cartas/" class="boton secundario claro">Ver el significado de las cartas</a>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <span class="etiqueta">Tiradas</span>
      <h2>Elige tu tirada</h2>
      <div class="tiradas">
        <a href="/tarot-si-o-no/" class="tirada-tarjeta">
          <span class="icono">☯</span>
          <h3>Tarot Sí o No</h3>
          <p>Una pregunta, una carta y una respuesta clara con su explicación.</p>
          <span class="ir">Hacer la tirada →</span>
        </a>
        <div class="tirada-tarjeta pronto">
          <span class="icono">♡</span>
          <h3>Tarot del Amor</h3>
          <p>Tres cartas para entender qué siente, qué te frena y hacia dónde va la relación.</p>
          <span class="ir">Muy pronto</span>
        </div>
        <div class="tirada-tarjeta pronto">
          <span class="icono">☀</span>
          <h3>Carta del día</h3>
          <p>Un mensaje para hoy, con un consejo sencillo para ponerlo en práctica.</p>
          <span class="ir">Muy pronto</span>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion fondo-crema">
    <div class="contenedor">
      <span class="etiqueta">Arcanos Mayores</span>
      <h2>Conoce las cartas</h2>
      <p class="sub">Cada carta tiene su historia, su consejo y su lectura en el amor y el trabajo.</p>
      <div class="destacadas">
        {
          destacadas.map((a) => (
            <a href={`/cartas/${a.slug}/`} class="destacada">
              <Carta arcano={a} tamano="pequena" />
            </a>
          ))
        }
      </div>
      <a href="/cartas/" class="boton secundario">Ver las 22 cartas</a>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor aurora">
      <div>
        <span class="etiqueta">La voz detrás de las cartas</span>
        <h2>«Mi abuela decía que las cartas no se leen con los ojos, sino con la paciencia.»</h2>
        <p>
          Las interpretaciones de esta web están escritas con la voz de Aurora: serena, honesta y sin dramas. Nada de
          predicciones que asustan ni promesas imposibles. Solo cartas que te ayudan a pensar.
        </p>
        <a href="/sobre-aurora/">Conoce a Aurora →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .portada {
    background:
      linear-gradient(90deg, rgba(36, 18, 48, 0.92) 0%, rgba(36, 18, 48, 0.7) 45%, rgba(36, 18, 48, 0.15) 100%),
      url('/portada.webp') center / cover no-repeat,
      var(--morado-oscuro);
    color: var(--crema);
    padding: 110px 0 120px;
  }
  .portada-texto { max-width: 560px; }
  .portada h1 { color: var(--crema); }
  .portada p { font-size: 1.15rem; color: var(--crema-oscura); }
  .portada .etiqueta { color: var(--dorado); }
  .botones { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .boton.secundario.claro { color: var(--crema); border-color: var(--crema-oscura); }
  .boton.secundario.claro:hover { background: var(--crema); color: var(--morado); }
  @media (max-width: 640px) {
    .portada {
      background:
        linear-gradient(180deg, rgba(36, 18, 48, 0.85), rgba(36, 18, 48, 0.92)),
        url('/portada.webp') center / cover no-repeat,
        var(--morado-oscuro);
      padding: 72px 0 80px;
    }
  }

  .tiradas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .tirada-tarjeta {
    background: #fff;
    border: 1px solid var(--crema-oscura);
    border-radius: var(--radio);
    padding: 28px;
    text-decoration: none;
    color: var(--tinta);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  a.tirada-tarjeta:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(59, 31, 74, 0.12); }
  .icono { font-size: 2rem; color: var(--terracota); }
  .ir { font-weight: 600; color: var(--morado-claro); }
  .pronto { opacity: 0.65; }
  .pronto .ir { color: var(--tinta-suave); }

  .fondo-crema { background: var(--crema-oscura); }
  .sub { color: var(--tinta-suave); }
  .destacadas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 140px));
    gap: 20px;
    margin: 28px 0 32px;
  }
  @media (max-width: 640px) { .destacadas { grid-template-columns: repeat(2, minmax(0, 140px)); } }
  .destacada { transition: transform 0.2s; }
  .destacada:hover { transform: translateY(-6px) rotate(-1deg); }

  .aurora { max-width: 760px; text-align: center; }
  .aurora h2 { font-style: italic; }
</style>
