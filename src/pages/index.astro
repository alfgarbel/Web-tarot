---
import Base from '../layouts/Base.astro';
import Carta from '../components/Carta.astro';
import SelectorBaraja from '../components/SelectorBaraja.astro';
import { arcanos } from '../data/arcanos';

const abanico = [-24, -16, -8, 0, 8, 16, 24];
---

<Base
  title="Noctámbula: tarot gratis y significado de las cartas"
  description="Tiradas de tarot gratis, sin registro, con interpretaciones escritas a mano. Pregunta al tarot Sí o No y descubre el significado de los 22 Arcanos Mayores."
>
  <link rel="preload" as="image" href="/mesa-arco.webp" slot="head" />

  <section class="portada">
    <div class="contenedor portada-rejilla">
      <div class="portada-texto">
        <h1>Pregunta a las cartas <em>esta noche.</em></h1>
        <p class="portada-sub">Tiradas de tarot gratis, escritas con calma y sin asustarte. Sin registro y sin letra pequeña.</p>
        <div class="botones">
          <a href="/tarot-si-o-no/" class="boton">Tirar una carta</a>
          <a href="/cartas/" class="enlace-flecha">Ver los arcanos</a>
        </div>
      </div>
      <figure class="portada-imagen">
        <img
          src="/mesa-arco.webp"
          width="800"
          height="1092"
          alt="Mesa con mantel de terciopelo morado, cartas de tarot boca abajo, velas encendidas y una taza de manzanilla en un patio andaluz."
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="tirada-promo">
    <div class="contenedor promo-rejilla">
      <a href="/tarot-si-o-no/" class="abanico revelar" aria-label="Ir a la tirada de Tarot Sí o No">
        {abanico.map((giro, i) => <span class="dorso" style={`--giro:${giro}deg; --i:${i}`} />)}
      </a>
      <div class="promo-texto revelar">
        <span class="antetitulo">Tarot Sí o No</span>
        <h2>Una pregunta. Una carta. <em>Una respuesta.</em></h2>
        <p class="suave">
          Piensa en lo que te quita el sueño, baraja y elige. Cada carta trae su respuesta y la razón que hay detrás.
        </p>
        <a href="/tarot-si-o-no/" class="boton linea">Hacer la tirada</a>
      </div>
    </div>
  </section>

  <section class="mas-tiradas">
    <div class="contenedor mas-rejilla">
      <div class="revelar">
        <span class="antetitulo">Más tiradas</span>
        <h2>Cuando una carta <em>no basta</em></h2>
        <a href="/tiradas/" class="enlace-flecha">Ver todas las tiradas</a>
      </div>
      <ul class="mas-lista revelar">
        <li data-tono="terracota"><a href="/tarot-del-amor/"><span>Tarot del amor</span><span>Tú, la otra persona y la relación</span></a></li>
        <li data-tono="azulejo"><a href="/pasado-presente-futuro/"><span>Pasado, presente y futuro</span><span>La tirada clásica de tres cartas</span></a></li>
        <li data-tono="romero"><a href="/carta-del-dia/"><span>Carta del día</span><span>Un mensaje para orientar tu jornada</span></a></li>
      </ul>
    </div>
  </section>

  <section class="arcanos">
    <div class="contenedor">
      <div class="arcanos-cabecera revelar">
        <h2>Los veintidós <em>arcanos mayores</em></h2>
        <a href="/cartas/" class="enlace-flecha">Ver todos</a>
      </div>
      <SelectorBaraja />
    </div>
    <div class="tira" role="list">
      {
        arcanos.map((a) => (
          <a href={`/cartas/${a.slug}/`} class="tira-item" role="listitem">
            <Carta arcano={a} tamano="pequena" />
            <span class="tira-claves">{a.claves[0]}</span>
          </a>
        ))
      }
    </div>
  </section>

  <div class="azulejos" aria-hidden="true"></div>
  <section class="principios seccion-cal">
    <div class="contenedor principios-rejilla">
      <img
        class="principios-imagen revelar"
        src="/velas.webp"
        width="900"
        height="810"
        loading="lazy"
        alt="Velas encendidas y cartas de tarot sobre terciopelo morado."
      />
      <div class="principios-texto revelar">
        <h2>Las cartas proponen. <em>Tú decides.</em></h2>
        <dl>
          <div>
            <dt>Respuestas con su porqué</dt>
            <dd>Ningún «sí» o «no» sin una explicación que te ayude a entenderlo.</dd>
          </div>
          <div>
            <dt>Nada de miedo para vender</dt>
            <dd>No hay maldiciones, amarres ni urgencias. Solo lectura y reflexión.</dd>
          </div>
          <div>
            <dt>Tu pregunta es tuya</dt>
            <dd>Lo que escribes no se envía ni se guarda. Se queda en tu pantalla.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Portada: texto a la izquierda, imagen en arco a la derecha. */
  .portada { padding: 56px 0 96px; }
  .portada-rejilla {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: center;
    min-height: calc(100dvh - 68px - 152px);
  }
  .portada h1 { max-width: 11ch; }
  .portada-sub { font-size: 1.15rem; color: var(--texto-suave); max-width: 40ch; }
  .botones { display: flex; align-items: center; gap: 28px; margin-top: 36px; flex-wrap: wrap; }
  .portada-imagen { margin: 0; justify-self: end; width: 100%; max-width: 440px; }
  .portada-imagen img {
    width: 100%;
    height: auto;
    border-radius: 999px 999px var(--radio) var(--radio);
    border: 1px solid var(--linea);
    padding: 10px;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .portada-texto > * { animation: subir 1s var(--ease) both; }
    .portada-texto > :nth-child(2) { animation-delay: 0.1s; }
    .portada-texto > :nth-child(3) { animation-delay: 0.2s; }
    .portada-imagen { animation: aparecer 1.4s 0.15s var(--ease) both; }
  }
  @keyframes subir { from { opacity: 0; transform: translateY(18px); } }
  @keyframes aparecer { from { opacity: 0; transform: scale(0.97); } }
  @media (max-width: 860px) {
    .portada { padding: 32px 0 64px; }
    .portada-rejilla { grid-template-columns: 1fr; gap: 40px; min-height: 0; }
    .portada-imagen { justify-self: center; max-width: 320px; }
  }

  /* Promo de la tirada: abanico de cartas a la izquierda. */
  .tirada-promo {
    padding: 112px 0;
    background:
      radial-gradient(60% 80% at 25% 50%, rgba(46, 76, 140, 0.45), transparent 70%),
      linear-gradient(180deg, var(--noche) 0%, var(--azulejo-noche) 50%, var(--noche) 100%);
  }
  .promo-rejilla { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .abanico {
    position: relative;
    height: 360px;
    display: block;
  }
  .abanico .dorso {
    position: absolute;
    width: 150px;
    left: calc(50% - 75px);
    bottom: 0;
    transform-origin: 50% 140%;
    transform: rotate(var(--giro));
    transition: transform 0.6s var(--ease);
  }
  .abanico:hover .dorso { transform: rotate(calc(var(--giro) * 1.35)); }
  .abanico:hover .dorso:nth-child(4) { transform: translateY(-14px); }
  .promo-texto h2 { max-width: 13ch; }
  .promo-texto p { max-width: 44ch; margin-bottom: 32px; }
  @media (max-width: 860px) {
    .tirada-promo { padding: 72px 0; }
    .promo-rejilla { grid-template-columns: 1fr; gap: 40px; }
    .abanico { height: 270px; }
    .abanico .dorso { width: 112px; left: calc(50% - 56px); }
  }

  /* Tira horizontal de los 22 arcanos. */
  .arcanos { padding: 112px 0 96px; }
  .arcanos-cabecera { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; flex-wrap: wrap; }
  .tira {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 168px;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 24px max(24px, calc((100vw - var(--ancho)) / 2 + 24px)) 28px;
    scrollbar-width: thin;
    scrollbar-color: var(--linea) transparent;
  }
  .tira-item {
    scroll-snap-align: start;
    text-decoration: none;
    display: grid;
    gap: 12px;
    justify-items: center;
    transition: transform 0.5s var(--ease);
  }
  .tira-item:hover { transform: translateY(-8px); }
  .tira-claves { font-size: 0.85rem; color: var(--texto-suave); }
  @media (max-width: 640px) {
    .arcanos { padding: 72px 0 56px; }
    .tira { grid-auto-columns: 132px; gap: 14px; padding-left: 18px; padding-right: 18px; }
  }

  /* Principios: imagen grande y lista editorial. */
  .principios { padding: 104px 0 120px; }
  .principios-imagen { box-shadow: 0 30px 60px -30px rgba(43, 26, 44, 0.6); }
  .principios-rejilla { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 72px; align-items: center; }
  .principios-imagen { width: 100%; height: auto; border-radius: 999px 999px var(--radio) var(--radio); }
  dl { margin: 40px 0 0; display: grid; gap: 28px; }
  dl div { border-left: 2px solid var(--terracota); padding-left: 22px; }
  dt { font-family: var(--serif); font-size: 1.45rem; margin-bottom: 4px; }
  dd { margin: 0; color: var(--tinta-suave); max-width: 46ch; }
  @media (max-width: 860px) {
    .principios { padding: 64px 0 80px; }
    .principios-rejilla { grid-template-columns: 1fr; gap: 40px; }
  }
  .mas-tiradas { padding: 96px 0 104px; }
  .mas-rejilla { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 72px; align-items: start; }
  .mas-rejilla h2 { max-width: 12ch; }
  .mas-lista { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--linea-suave); }
  .mas-lista li { border-bottom: 1px solid var(--linea-suave); }
  .mas-lista li[data-tono='terracota'] { --tono: var(--terracota-claro); }
  .mas-lista li[data-tono='azulejo'] { --tono: var(--azulejo-claro); }
  .mas-lista li[data-tono='romero'] { --tono: var(--romero-claro); }
  .mas-lista a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 24px;
    padding: 26px 0;
    text-decoration: none;
    color: var(--texto);
  }
  .mas-lista a span:first-child { font-family: var(--serif); font-size: clamp(1.5rem, 2.6vw, 2rem); transition: color 0.3s; }
  .mas-lista a span:last-child { color: var(--texto-suave); grid-column: 1; }
  .mas-lista a::after { content: '→'; grid-column: 2; grid-row: 1 / span 2; align-self: center; color: var(--tono); font-size: 1.4rem; transition: transform 0.4s var(--ease); }
  .mas-lista a:hover span:first-child { color: var(--tono); }
  .mas-lista a:hover::after { transform: translateX(6px); }
  @media (max-width: 820px) {
    .mas-rejilla { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
