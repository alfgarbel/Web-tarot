---
import Base from '../../layouts/Base.astro';
import Carta from '../../components/Carta.astro';
import SelectorBaraja from '../../components/SelectorBaraja.astro';
import { arcanos } from '../../data/arcanos';
---

<Base
  title="Significado de las cartas del tarot: los 22 Arcanos Mayores | Noctámbula"
  description="El significado de los 22 Arcanos Mayores del tarot: qué dice cada carta en el amor, el trabajo, al derecho y al revés, y su respuesta de sí o no."
>
  <section class="cabeza">
    <div class="contenedor">
      <h1>Los veintidós <em>arcanos mayores</em></h1>
      <p class="sub">
        Del Loco, que empieza sin mapa, al Mundo, que completa el camino. Elige una carta para leer qué dice en el amor, el
        trabajo y la vida.
      </p>
      <SelectorBaraja />
    </div>
  </section>

  <section class="contenedor">
    <ol class="rejilla">
      {
        arcanos.map((a) => (
          <li>
            <a href={`/cartas/${a.slug}/`} class="item">
              <Carta arcano={a} tamano="pequena" />
              <span class="claves">{a.claves.join(', ')}</span>
              <span class="respuesta" data-tipo={a.respuesta === 'Sí' ? 'si' : a.respuesta === 'No' ? 'no' : 'quizas'}>{a.respuesta}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .cabeza { padding: 72px 0 24px; }
  .cabeza h1 { max-width: 14ch; }
  .sub { max-width: 56ch; font-size: 1.15rem; color: var(--texto-suave); margin-bottom: 32px; }
  .rejilla {
    list-style: none;
    padding: 0;
    margin: 40px 0 80px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 44px 24px;
  }
  .item {
    text-decoration: none;
    display: grid;
    gap: 14px;
    justify-items: center;
    transition: transform 0.5s var(--ease);
  }
  .item:hover { transform: translateY(-8px); }
  .claves { font-size: 0.85rem; color: var(--texto-suave); text-align: center; }
  .respuesta { font-family: var(--serif); font-style: italic; font-size: 1.05rem; color: var(--veredicto); margin-top: -8px; }
  @media (max-width: 520px) {
    .rejilla { grid-template-columns: repeat(2, 1fr); gap: 32px 16px; }
  }
</style>
