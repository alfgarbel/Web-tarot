---
import Base from '../../layouts/Base.astro';
import Carta from '../../components/Carta.astro';
import SelectorBaraja from '../../components/SelectorBaraja.astro';
import { arcanos, type Arcano } from '../../data/arcanos';
import { menores } from '../../data/menores';
import { combinaciones, slugCombinacion } from '../../data/combinaciones';
import { signos } from '../../data/signos';
import { ampliados } from '../../data/ampliado';

const todas = [...arcanos, ...menores];

export function getStaticPaths() {
  return [...arcanos, ...menores].map((arcano) => ({ params: { slug: arcano.slug }, props: { arcano } }));
}

const { arcano } = Astro.props as { arcano: Arcano };
const i = todas.findIndex((a) => a.slug === arcano.slug);
const anterior = todas[i - 1];
const signosCarta = signos.filter((x) => x.arcano === arcano.slug);
const nombreDe = (slug: string) => arcanos.find((a) => a.slug === slug)!.nombre;
const pares = combinaciones
  .filter((c) => c.a === arcano.slug || c.b === arcano.slug)
  .map((c) => ({ href: `/combinaciones/${slugCombinacion(c)}/`, otra: nombreDe(c.a === arcano.slug ? c.b : c.a) }));
const siguiente = todas[i + 1];

const amp = ampliados[arcano.slug];
const url = new URL(`/cartas/${arcano.slug}/`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: `${arcano.nombre}: significado en el tarot`,
      description: arcano.general,
      inLanguage: 'es-ES',
      mainEntityOfPage: url,
      dateModified: new Date().toISOString().slice(0, 10),
      image: new URL(arcano.sinImagen ? '/portada.webp' : `/barajas/ilustrada/${arcano.slug}.webp`, Astro.site).href,
      author: { '@type': 'Organization', name: 'Arcanaia' },
      publisher: { '@type': 'Organization', name: 'Arcanaia' },
    },
    {
      // Las mismas respuestas que se ven en la ficha, en forma de pregunta.
      '@type': 'FAQPage',
      mainEntity: (amp ? amp.faq.map((f) => [f.q, f.r]) : [
        [`¿Qué significa ${arcano.nombre} en el tarot?`, `Con ${arcano.nombre} salen temas como ${arcano.claves.join(', ')}. ${arcano.general}`],
        [`¿Qué significa ${arcano.nombre} en el amor?`, arcano.amor],
        [`¿Qué significa ${arcano.nombre} en el trabajo y el dinero?`, arcano.trabajo],
        [`¿Qué significa ${arcano.nombre} en la salud?`, arcano.salud],
        [`¿Qué significa ${arcano.nombre} invertida?`, arcano.invertida],
        [`¿${arcano.nombre} es sí o no?`, `${arcano.respuesta}. ${arcano.siNo}`],
      ]).map(([q, r]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: r } })),
    },
  ],
};

const secciones = [
  { titulo: 'En el amor', texto: arcano.amor },
  { titulo: 'En el trabajo y el dinero', texto: arcano.trabajo },
  { titulo: 'En la salud y el bienestar', texto: arcano.salud },
  { titulo: 'Invertida', texto: arcano.invertida },
];
---

<Base
  title={`${arcano.nombre}: significado en el tarot, amor y sí o no | Arcanaia`}
  migas={[{ nombre: 'Los arcanos', url: '/cartas/' }, { nombre: arcano.nombre, url: `/cartas/${arcano.slug}/` }]}
  description={`Qué significa ${arcano.nombre}${arcano.palo ? '' : ` (${arcano.romano})`} en el tarot: ${arcano.claves.join(', ')}. En el amor, el trabajo, la salud, invertida y en sí o no.`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="contenedor ficha">
    <aside class="lateral">
      <Carta arcano={arcano} />
      <div class="lateral-selector"><SelectorBaraja /></div>
    </aside>

    <div class="cuerpo">
      <nav class="migas" aria-label="Ruta"><a href="/cartas/">Los arcanos</a> <span aria-hidden="true">/</span> {arcano.nombre}</nav>
      <h1>{arcano.nombre}</h1>
      <p class="claves">{arcano.claves.join(', ')}</p>
      <p class="general">{arcano.general}</p>

      {
        amp && (
          <>
            <nav class="indice" aria-label="En esta ficha">
              <a href="#imagen">La imagen</a>
              <a href="#significado">Significado</a>
              <a href="#amor">Amor</a>
              <a href="#trabajo">Trabajo y dinero</a>
              <a href="#como">Sentimiento, persona y futuro</a>
              <a href="#invertida">Invertida</a>
              <a href="#preguntas">Preguntas</a>
            </nav>

            <section class="largo" id="imagen">
              <h2>La imagen y su simbolismo</h2>
              {amp.imagen.map((p) => <p>{p}</p>)}
            </section>

            <section class="largo" id="significado">
              <h2>Qué significa {arcano.nombre}</h2>
              {amp.significado.map((p) => <p>{p}</p>)}
            </section>

            <section class="largo" id="amor">
              <h2>{arcano.nombre} en el amor</h2>
              <p>{arcano.amor}</p>
              <div class="casos">
                <div><h3>Si tienes pareja</h3><p>{amp.amor.pareja}</p></div>
                <div><h3>Si estás sola</h3><p>{amp.amor.sola}</p></div>
                <div><h3>Si piensas en tu ex</h3><p>{amp.amor.ex}</p></div>
              </div>
            </section>

            <div class="bloques" id="trabajo">
              <section><h2>En el trabajo</h2><p>{arcano.trabajo}</p><p>{amp.trabajo}</p></section>
              <section><h2>En el dinero</h2><p>{amp.dinero}</p></section>
              <section><h2>En la salud y el bienestar</h2><p>{arcano.salud}</p></section>
            </div>

            <section class="largo" id="como">
              <h2>Como sentimiento, como persona y como futuro</h2>
              <div class="casos">
                <div><h3>Como sentimiento</h3><p>{amp.como.sentimiento}</p></div>
                <div><h3>Como persona</h3><p>{amp.como.persona}</p></div>
                <div><h3>Como futuro</h3><p>{amp.como.futuro}</p></div>
              </div>
            </section>

            <section class="largo" id="invertida">
              <h2>{arcano.nombre} invertida</h2>
              <p>{arcano.invertida}</p>
              {amp.invertida.map((p) => <p>{p}</p>)}
            </section>
          </>
        )
      }

      {
        !amp && (
          <div class="bloques">
            {secciones.map((s) => (
              <section>
                <h2>{s.titulo}</h2>
                <p>{s.texto}</p>
              </section>
            ))}
          </div>
        )
      }

      <section class="sino" data-tipo={arcano.respuesta === 'Sí' ? 'si' : arcano.respuesta === 'No' ? 'no' : 'quizas'}>
        <h2>Como respuesta de sí o no</h2>
        <p class="sino-respuesta">{arcano.respuesta}</p>
        <p>{arcano.siNo}</p>
        <a href="/tarot-si-o-no/" class="boton linea">Hacer la tirada</a>
      </section>

      {
        pares.length > 0 && (
          <section class="pares">
            <h2>Combinada con otras cartas</h2>
            <ul>
              {pares.map((p) => (
                <li><a href={p.href}>{arcano.nombre} y {p.otra}</a></li>
              ))}
            </ul>
          </section>
        )
      }

      {
        signosCarta.length > 0 && (
          <p class="signo-carta">
            Por tradición, esta carta va con {signosCarta.map((x, k) => <>{k > 0 && ' y '}<a href={`/signos/${x.slug}/`}>{x.nombre}</a></>)}.
            Y si te apetece, echa un vistazo al <a href={`/horoscopo/${signosCarta[0].slug}/`}>horóscopo de hoy de {signosCarta[0].nombre}</a>.
          </p>
        )
      }

      <blockquote class="consejo">{arcano.consejo}</blockquote>

      {
        amp && (
          <section class="preguntas" id="preguntas">
            <h2>Preguntas frecuentes sobre {arcano.nombre}</h2>
            {amp.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.r}</p>
              </details>
            ))}
          </section>
        )
      }

      <nav class="pasar" aria-label="Otras cartas">
        {anterior ? <a href={`/cartas/${anterior.slug}/`} class="enlace-flecha">{anterior.palo ? anterior.nombre : `${anterior.romano}. ${anterior.nombre}`}</a> : <span />}
        {siguiente ? <a href={`/cartas/${siguiente.slug}/`} class="enlace-flecha">{siguiente.palo ? siguiente.nombre : `${siguiente.romano}. ${siguiente.nombre}`}</a> : <span />}
      </nav>
    </div>
  </article>
</Base>

<style>
  .ficha {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 96px;
    align-items: start;
    padding-top: 72px;
    padding-bottom: 64px;
  }
  .lateral { position: sticky; top: 108px; }
  .lateral :global(.carta) { max-width: 300px; }
  .lateral-selector { margin-top: 24px; max-width: 300px; }
  .lateral-selector :global(.selector-baraja) { flex-direction: column; align-items: stretch; }
  .lateral-selector :global(.selector-titulo) { margin-bottom: 4px; }
  .migas { font-size: 0.9rem; color: var(--texto-suave); margin-bottom: 28px; }
  .migas a { color: var(--texto-suave); }
  .cuerpo { max-width: 680px; }
  .claves { color: var(--oro); font-family: var(--serif); font-style: italic; font-size: 1.3rem; margin-top: -0.4em; }
  .general { font-size: 1.2rem; line-height: 1.7; margin-top: 28px; }
  .general::first-letter {
    font-family: var(--serif);
    float: left;
    font-size: 4.2em;
    line-height: 0.85;
    padding: 6px 6px 0 0;
    color: var(--oro-claro);
  }
  .bloques { display: grid; grid-template-columns: 1fr 1fr; gap: 36px 48px; margin-top: 56px; }
  .bloques section:first-child { grid-column: 1 / -1; }
  .bloques h2, .sino h2 { font-size: 1.6rem; }
  .bloques p { color: var(--texto-suave); }
  .bloques section { border-top: 2px solid var(--marca); padding-top: 18px; }
  .bloques section:nth-child(1) { --marca: var(--terracota); }
  .bloques section:nth-child(2) { --marca: var(--romero); }
  .bloques section:nth-child(3) { --marca: var(--oro); }
  .bloques section:nth-child(4) { --marca: var(--azulejo); grid-column: 1 / -1; }
  .pares { margin-top: 56px; }
  .indice { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 40px; padding: 16px 0; border-top: 1px solid var(--linea-suave); border-bottom: 1px solid var(--linea-suave); font-size: 0.9rem; }
  .indice a { color: var(--texto-suave); text-decoration: none; }
  .indice a:hover { color: var(--oro-claro); }
  .largo { margin-top: 56px; scroll-margin-top: 96px; }
  .largo h2 { font-size: 1.8rem; }
  .largo > p { color: var(--texto-suave); line-height: 1.75; }
  .largo > p + p { margin-top: 0.8em; }
  .casos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 28px; }
  .casos div { border-top: 2px solid var(--terracota); padding-top: 14px; }
  #como .casos div { border-top-color: var(--azulejo); }
  .casos h3 { font-family: var(--sans); font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--oro); margin: 0 0 8px; }
  .casos p { color: var(--texto-suave); font-size: 0.98rem; margin: 0; }
  #trabajo { scroll-margin-top: 96px; }
  #trabajo section:first-child { grid-column: auto; }
  #trabajo section:nth-child(3) { grid-column: 1 / -1; }
  .bloques p + p { margin-top: 0.6em; }
  .preguntas { margin-top: 72px; scroll-margin-top: 96px; }
  .preguntas h2 { font-size: 1.6rem; }
  .preguntas details { border-top: 1px solid var(--linea-suave); padding: 16px 0; }
  .preguntas details:last-of-type { border-bottom: 1px solid var(--linea-suave); }
  .preguntas summary { cursor: pointer; font-size: 1.05rem; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .preguntas summary::after { content: '+'; color: var(--oro); font-size: 1.3rem; line-height: 1; transition: transform 0.3s var(--ease); }
  .preguntas details[open] summary::after { transform: rotate(45deg); }
  .preguntas summary::-webkit-details-marker { display: none; }
  .preguntas details p { color: var(--texto-suave); margin: 10px 0 0; }
  .signo-carta { margin-top: 40px; color: var(--texto-suave); }
  .pares h2 { font-size: 1.6rem; }
  .pares ul { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .pares a { display: inline-block; padding: 8px 14px; border: 1px solid var(--linea-suave); border-radius: 999px; color: var(--texto-suave); text-decoration: none; font-size: 0.95rem; }
  .pares a:hover { border-color: var(--oro); color: var(--oro-claro); }
  .sino {
    margin-top: 64px;
    padding: 40px;
    border: 1px solid color-mix(in srgb, var(--veredicto) 40%, transparent);
    border-radius: var(--radio);
    background: linear-gradient(160deg, color-mix(in srgb, var(--veredicto) 14%, transparent), transparent 70%);
  }
  .sino-respuesta { font-family: var(--serif); font-size: 3.4rem; line-height: 1; color: var(--veredicto); margin-bottom: 16px; }
  .sino p:not(.sino-respuesta) { color: var(--texto-suave); max-width: 54ch; margin-bottom: 28px; }
  .consejo {
    margin: 72px 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    line-height: 1.2;
    padding-bottom: 0.1em;
  }
  .consejo::before { content: '«'; color: var(--oro); }
  .consejo::after { content: '»'; color: var(--oro); }
  .pasar { display: flex; justify-content: space-between; gap: 16px; margin-top: 80px; padding-top: 28px; border-top: 1px solid var(--linea-suave); }
  @media (max-width: 860px) {
    .ficha { grid-template-columns: 1fr; gap: 40px; padding-top: 40px; }
    .lateral { position: static; justify-self: center; width: 220px; }
    .bloques { grid-template-columns: 1fr; }
    .casos { grid-template-columns: 1fr; gap: 20px; }
    .sino { padding: 28px 22px; }
  }
</style>
