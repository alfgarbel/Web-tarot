---
import Base from '../layouts/Base.astro';

const tiradas = [
  {
    href: '/tarot-del-amor/',
    titulo: 'Tarot del amor',
    cartas: 3,
    texto: 'Tú, la otra persona y la relación. Para entender qué está pasando en tu historia y hacia dónde va.',
    tono: 'terracota',
  },
  {
    href: '/volvera-mi-ex/',
    titulo: '¿Volverá mi ex?',
    cartas: 3,
    texto: 'Lo que os separó, lo que siente hoy y una respuesta clara: sí, no o quizás, con su porqué.',
    tono: 'azulejo',
  },
  {
    href: '/tarot-si-o-no/',
    titulo: 'Tarot Sí o No',
    cartas: 1,
    texto: 'Una pregunta, una carta y una respuesta clara con su explicación. Para cuando necesitas decidir.',
    tono: 'oro',
  },
  {
    href: '/pasado-presente-futuro/',
    titulo: 'Pasado, presente y futuro',
    cartas: 3,
    texto: 'La tirada clásica. De dónde vienes, dónde estás y hacia dónde te llevan tus pasos.',
    tono: 'romero',
  },
  {
    href: '/cruz-celta/',
    titulo: 'Cruz celta',
    cartas: 10,
    texto: 'La tirada más completa. Diez cartas para mirar a fondo una situación importante desde todos sus ángulos.',
    tono: 'terracota',
  },
  {
    href: '/carta-del-dia/',
    titulo: 'Carta del día',
    cartas: 1,
    texto: 'Un arcano y un mensaje para orientar tu jornada. Cada día, una carta nueva.',
    tono: 'oro',
  },
];

const porTema = [
  {
    href: '/tarot-del-trabajo/',
    titulo: 'Trabajo y dinero',
    cartas: 3,
    texto: 'Tu momento profesional, lo que te frena y hacia dónde va tu economía.',
    tono: 'oro',
  },
  {
    href: '/tarot-de-la-salud/',
    titulo: 'Salud y bienestar',
    cartas: 3,
    texto: 'Tu energía, lo que necesitas y cómo cuidarte. Para escucharte, nunca para diagnosticar.',
    tono: 'romero',
  },
  {
    href: '/dos-caminos/',
    titulo: 'Decidir entre dos caminos',
    cartas: 4,
    texto: 'La situación, lo que trae cada opción y la clave para elegir.',
    tono: 'azulejo',
  },
];

const extra = { href: '/compatibilidad/', titulo: 'Compatibilidad de signos', texto: 'Tu signo y el de la otra persona: cuánto encajáis, qué os une y dónde chocáis, con vuestras cartas del tarot.' };
---

<Base
  title="Tiradas de tarot gratis: amor, sí o no y más | Arcanaia"
  description="Todas las tiradas de tarot gratis de Arcanaia: tarot del amor, sí o no, pasado presente y futuro y carta del día. Sin registro y escritas a mano."
>
  <section class="cabeza">
    <div class="contenedor">
      <h1>Elige <em>tu tirada</em></h1>
      <p class="sub">Todas son gratis, sin registro y con textos escritos a mano para cada carta y cada posición.</p>
    </div>
  </section>

  <section class="contenedor">
    {
      [
        { titulo: 'Las tiradas', lista: tiradas },
        { titulo: 'Por tema', lista: porTema },
      ].map((grupo) => (
        <>
          <h2 class="grupo">{grupo.titulo}</h2>
          <ol class="lista">
            {grupo.lista.map((t) => (
              <li class="revelar" data-tono={t.tono}>
                <a href={t.href} class="fila">
                  <span class="mazo" style={`--n:${Math.min(t.cartas, 5)}; --paso:${t.cartas > 3 ? 16 : 30}px; --abre:${t.cartas > 3 ? 7 : 9}deg`} aria-hidden="true">
                    {Array.from({ length: Math.min(t.cartas, 5) }, (_, i) => (
                      <span class="dorso" style={`--i:${i}`} />
                    ))}
                  </span>
                  <span class="nombre">{t.titulo}</span>
                  <span class="detalle">
                    <span class="cuantas">{{ 1: 'Una carta', 3: 'Tres cartas', 4: 'Cuatro cartas', 10: 'Diez cartas' }[t.cartas]}</span>
                    {t.texto}
                  </span>
                  <span class="flecha" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
        </>
      ))
    }
    <a href={extra.href} class="extra">
      <span class="extra-etiqueta">Y además</span>
      <span class="extra-titulo">{extra.titulo}</span>
      <span class="extra-texto">{extra.texto}</span>
    </a>
  </section>
</Base>

<style>
  .cabeza { padding: 72px 0 32px; }
  .sub { max-width: 52ch; font-size: 1.15rem; color: var(--texto-suave); }
  .grupo { font-size: 0.85rem; font-family: var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--oro); margin: 56px 0 16px; }
  .lista { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--linea-suave); }
  li[data-tono='terracota'] { --tono: var(--terracota-claro); }
  li[data-tono='oro'] { --tono: var(--oro-claro); }
  li[data-tono='azulejo'] { --tono: var(--azulejo-claro); }
  li[data-tono='romero'] { --tono: var(--romero-claro); }
  .lista li { border-bottom: 1px solid var(--linea-suave); }
  .fila {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) minmax(0, 1.1fr) 40px;
    gap: 40px;
    align-items: center;
    padding: 40px 0;
    text-decoration: none;
    color: var(--texto);
  }
  .mazo { position: relative; height: 110px; display: block; }
  .mazo .dorso {
    position: absolute;
    width: 64px;
    left: calc(50% - 32px + (var(--i) - (var(--n) - 1) / 2) * var(--paso));
    bottom: 0;
    transform: rotate(calc((var(--i) - (var(--n) - 1) / 2) * var(--abre)));
    transform-origin: 50% 120%;
    transition: transform 0.5s var(--ease);
  }
  .fila:hover .mazo .dorso { transform: rotate(calc((var(--i) - (var(--n) - 1) / 2) * 14deg)) translateY(-6px); }
  .nombre { font-family: var(--serif); font-size: clamp(1.9rem, 3.4vw, 2.8rem); line-height: 1.05; transition: color 0.3s; }
  .fila:hover .nombre { color: var(--tono); }
  .detalle { color: var(--texto-suave); }
  .cuantas { display: block; font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--tono); margin-bottom: 6px; }
  .flecha { font-size: 1.6rem; color: var(--tono); transition: transform 0.4s var(--ease); }
  .fila:hover .flecha { transform: translateX(6px); }
  .extra {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 40px;
    align-items: center;
    margin: 48px 0 96px;
    padding: 32px 0;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    text-decoration: none;
    color: var(--texto);
    background: linear-gradient(110deg, rgba(46, 76, 140, 0.28), transparent 70%);
    transition: border-color 0.3s;
  }
  .extra:hover { border-color: var(--oro); }
  .extra-etiqueta { justify-self: center; font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--oro); }
  .extra-titulo { font-family: var(--serif); font-size: clamp(1.7rem, 3vw, 2.4rem); line-height: 1.05; }
  .extra-texto { color: var(--texto-suave); padding-right: 32px; }
  @media (max-width: 820px) {
    .extra { grid-template-columns: 1fr; gap: 8px; padding: 24px; }
    .extra-etiqueta { justify-self: start; }
    .extra-texto { padding-right: 0; }
  }
  @media (max-width: 820px) {
    .fila { grid-template-columns: 96px 1fr; gap: 8px 24px; padding: 28px 0; }
    .mazo { grid-row: span 2; height: 84px; }
    .mazo .dorso { width: 46px; left: calc(50% - 23px + (var(--i) - (var(--n) - 1) / 2) * var(--paso) * 0.66); }
    .flecha { display: none; }
  }
</style>
