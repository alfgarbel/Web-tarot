---
import Base from '../layouts/Base.astro';
import Carta from '../components/Carta.astro';
import SelectorBaraja from '../components/SelectorBaraja.astro';
import { arcanos } from '../data/arcanos';

const datos = arcanos.map(({ romano, nombre, slug, simbolo, respuesta, siNo, consejo }) => ({
  romano,
  nombre,
  slug,
  simbolo,
  respuesta,
  siNo,
  consejo,
}));

const preguntas = ['¿Volverá mi ex?', '¿Me quiere de verdad?', '¿Debo escribirle?', '¿Conseguiré ese trabajo?'];

const faq = [
  {
    p: '¿Cómo funciona el tarot Sí o No?',
    r: 'Piensas una pregunta que se conteste con sí o con no, barajas y eliges una de las cartas de los 22 Arcanos Mayores. Cada una trae su respuesta (sí, no o quizás) y un par de frases que explican el porqué.',
  },
  {
    p: '¿Es gratis?',
    r: 'Sí. Tira las veces que quieras, sin registrarte y sin dejar ningún dato.',
  },
  {
    p: '¿Puedo preguntar varias veces lo mismo?',
    r: 'Tu navegador guarda lo que preguntas durante 24 horas. Si repites la misma pregunta ese día, te sale la misma respuesta, y es lo lógico, porque la primera suele ser la que más tiene que decirte.',
  },
  {
    p: '¿Qué significa un «quizás»?',
    r: 'Que la cosa todavía no está decidida o que falta información. Lee la explicación de la carta, que te cuenta en qué fijarte o qué esperar.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.p,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
---

<Base
  title="Tarot Sí o No gratis: respuesta inmediata | Arcanaia"
  description="Haz tu pregunta, elige una carta y recibe una respuesta de sí o no con su explicación. Tarot Sí o No gratis y sin registro, con los 22 Arcanos Mayores."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <section class="mesa">
    <div class="contenedor">
      <div class="paso" id="paso-pregunta">
        <h1>Tarot <em>Sí o No</em></h1>
        <p class="sub">Piensa algo que se pueda contestar con un sí o un no. Respira y baraja.</p>
        <form class="formulario" id="formulario">
          <label for="pregunta">Tu pregunta <span class="suave">(opcional, solo queda en tu navegador)</span></label>
          <div class="campo">
            <input id="pregunta" type="text" maxlength="140" placeholder="¿Volverá a escribirme?" autocomplete="off" />
            <button class="boton" type="submit">Barajar</button>
          </div>
          <div class="sugerencias">
            {preguntas.map((p) => <button type="button" class="sugerencia">{p}</button>)}
          </div>
        </form>
        <div class="elegir-baraja"><SelectorBaraja /></div>
      </div>

      <div class="paso oculto" id="paso-elegir" aria-live="polite">
        <p class="instruccion">Quédate con la carta que más te llame</p>
        <div class="abanico" id="abanico"></div>
      </div>

      <div class="paso oculto" id="paso-resultado" aria-live="polite">
        <div class="resultado">
          <div class="giro" id="giro">
            <div class="cara dorso"></div>
            <div class="cara frente" id="frente"></div>
          </div>
          <div class="respuesta">
            <p class="tu-pregunta" id="tu-pregunta"></p>
            <p class="aviso-repetida" id="aviso" hidden></p>
            <p class="veredicto" id="veredicto"></p>
            <p class="carta-titulo" id="nombre-carta"></p>
            <p class="texto" id="texto"></p>
            <p class="consejo"><span>Consejo</span> <span id="consejo"></span></p>
            <div class="acciones">
              <button class="boton" id="otra" type="button">Preguntar otra cosa</button>
              <a class="enlace-flecha" id="enlace-carta" href="/cartas/">Leer la carta completa</a>
            </div>
            <p class="nota">Si hoy vuelves a hacer la misma pregunta, te saldrá la misma respuesta.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="azulejos" aria-hidden="true"></div>
  {arcanos.map((a) => <template id={`carta-${a.slug}`}><Carta arcano={a} /></template>)}

  <section class="contenido seccion-cal">
    <div class="contenedor estrecho">
      <h2>Cómo leer tu respuesta</h2>
      <p class="suave">
        El tarot no decide por ti. Lo que hace es ayudarte a ver la situación desde otro sitio, y por eso cada respuesta
        lleva su explicación. Un «sí» de la Torre se vive muy distinto que un «sí» del Sol, y un «no» del Ermitaño muchas
        veces quiere decir «todavía no».
      </p>
      <p class="suave">
        Aquí solo entran los 22 Arcanos Mayores, las cartas con más carga simbólica de la baraja. Si te pica la curiosidad
        por alguna, tienes <a href="/cartas/">el significado de los arcanos</a> uno por uno.
      </p>

      <h2 class="faq-titulo">Preguntas frecuentes</h2>
      {
        faq.map((f) => (
          <details>
            <summary>{f.p}</summary>
            <p class="suave">{f.r}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<script is:inline define:vars={{ datos }}>
  const $ = (id) => document.getElementById(id);
  const pasos = ['paso-pregunta', 'paso-elegir', 'paso-resultado'].map($);
  const abanico = $('abanico');
  const input = $('pregunta');

  const azar = (max) => {
    const u = new Uint32Array(1);
    crypto.getRandomValues(u);
    return u[0] % max;
  };

  const barajar = (lista) => {
    const copia = [...lista];
    for (let i = copia.length - 1; i > 0; i--) {
      const j = azar(i + 1);
      [copia[i], copia[j]] = [copia[j], copia[i]];
    }
    return copia;
  };

  const mostrar = (paso) => {
    pasos.forEach((p) => p.classList.add('oculto'));
    paso.classList.remove('oculto');
    paso.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  document.querySelectorAll('.sugerencia').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.textContent;
      input.focus();
    }),
  );

  const repartir = () => {
    const mazo = barajar(datos).slice(0, 9);
    abanico.innerHTML = '';
    mazo.forEach((carta, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'dorso elegible';
      b.style.setProperty('--i', i);
      b.style.setProperty('--giro', `${(i - 4) * 7}deg`);
      b.setAttribute('aria-label', `Carta ${i + 1} de 9`);
      b.addEventListener('click', () => {
        window.memoriaTirada?.guardar(location.pathname, input.value, [carta.slug]);
        revelar(carta, false);
      });
      abanico.appendChild(b);
    });
    mostrar(pasos[1]);
  };

  const revelar = (carta, repetida) => {
    const pregunta = input.value.trim();
    $('tu-pregunta').textContent = pregunta ? `«${pregunta}»` : '';
    const aviso = $('aviso');
    aviso.hidden = !repetida;
    aviso.textContent = pregunta
      ? 'Esta pregunta ya se la hiciste hoy a las cartas. Te contestaron esto y siguen pensando lo mismo.'
      : 'Ya has sacado una carta. Si tienes otra pregunta, escríbela y vuelve a barajar.';
    const molde = document.getElementById(`carta-${carta.slug}`);
    $('frente').replaceChildren(molde.content.cloneNode(true));
    const veredicto = $('veredicto');
    veredicto.textContent = carta.respuesta;
    veredicto.dataset.tipo = carta.respuesta === 'Sí' ? 'si' : carta.respuesta === 'No' ? 'no' : 'quizas';
    $('nombre-carta').textContent = `${carta.romano}. ${carta.nombre}`;
    $('texto').textContent = carta.siNo;
    $('consejo').textContent = carta.consejo;
    $('enlace-carta').href = `/cartas/${carta.slug}/`;
    const giro = $('giro');
    giro.classList.remove('girada');
    mostrar(pasos[2]);
    setTimeout(() => giro.classList.add('girada'), 300);
  };

  $('formulario').addEventListener('submit', (e) => {
    e.preventDefault();
    const previa = window.memoriaTirada?.leer(location.pathname, input.value);
    const carta = previa && datos.find((d) => d.slug === previa.cartas[0]);
    if (carta) revelar(carta, true);
    else repartir();
  });
  $('otra').addEventListener('click', () => {
    input.value = '';
    mostrar(pasos[0]);
  });
</script>

<style>
  .mesa {
    padding: 72px 0 96px;
    min-height: calc(100dvh - 68px);
    background: radial-gradient(70% 60% at 50% 30%, rgba(77, 42, 96, 0.55), transparent 70%);
  }
  .paso { scroll-margin-top: 96px; }
  .oculto { display: none; }

  #paso-pregunta { max-width: 640px; }
  .sub { font-size: 1.15rem; color: var(--texto-suave); margin-bottom: 40px; }
  label { display: block; font-size: 0.95rem; margin-bottom: 10px; }
  .campo {
    display: flex;
    gap: 8px;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 6px;
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.3s;
  }
  .campo:focus-within { border-color: var(--oro); }
  #pregunta {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: var(--texto);
    font: inherit;
    font-size: 1.05rem;
    padding: 10px 12px;
  }
  #pregunta::placeholder { color: #8f7f99; }
  #pregunta:focus { outline: none; }
  .sugerencias { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 18px; }
  .sugerencia {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 0.92rem;
    color: var(--texto-suave);
    border-bottom: 1px dotted var(--linea);
    cursor: pointer;
  }
  .sugerencia:hover { color: var(--oro-claro); }
  .elegir-baraja { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--linea-suave); }

  .instruccion { font-family: var(--serif); font-style: italic; font-size: 2rem; text-align: center; margin: 0; }
  .abanico {
    position: relative;
    height: 420px;
    max-width: 900px;
    margin: 24px auto 0;
  }
  .abanico :global(.elegible) {
    position: absolute;
    width: 150px;
    left: calc(50% - 75px);
    bottom: 10px;
    padding: 0;
    cursor: pointer;
    transform-origin: 50% 230%;
    transform: rotate(var(--giro));
    transition: transform 0.5s var(--ease), border-color 0.3s;
  }
  .abanico :global(.elegible:hover),
  .abanico :global(.elegible:focus-visible) {
    transform: rotate(var(--giro)) translateY(-26px);
    border-color: var(--oro-claro);
    outline: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .abanico :global(.elegible) { animation: repartir 0.7s calc(var(--i) * 55ms) var(--ease) both; }
  }
  @keyframes repartir { from { opacity: 0; transform: rotate(0deg) translateY(40px); } }
  @media (max-width: 640px) {
    .abanico {
      height: auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      max-width: 320px;
    }
    .abanico :global(.elegible) { position: relative; width: 100%; left: auto; bottom: auto; transform: none; }
    .abanico :global(.elegible:hover) { transform: translateY(-6px); }
    @keyframes repartir { from { opacity: 0; transform: translateY(20px); } }
  }

  .resultado {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 72px;
    align-items: center;
    max-width: 960px;
    margin: 0 auto;
  }
  .giro {
    width: 260px;
    aspect-ratio: 7 / 12;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 1s var(--ease);
  }
  .giro.girada { transform: rotateY(180deg); }
  .cara { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .frente { transform: rotateY(180deg); }
  .frente :global(.carta) { max-width: none; height: 100%; }
  .tu-pregunta { font-family: var(--serif); font-style: italic; font-size: 1.25rem; color: var(--texto-suave); }
  .veredicto { font-family: var(--serif); font-size: clamp(4rem, 9vw, 6.5rem); line-height: 1; margin: 0 0 8px; color: var(--veredicto, var(--oro-claro)); }
  .carta-titulo { font-size: 0.85rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--oro); margin-bottom: 20px; }
  .texto { font-size: 1.12rem; max-width: 52ch; }
  .consejo { border-left: 1px solid var(--oro); padding-left: 18px; color: var(--texto-suave); max-width: 52ch; }
  .consejo span:first-child { color: var(--texto); font-weight: 600; margin-right: 6px; }
  .acciones { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 32px; }
  .nota { font-size: 0.9rem; color: var(--texto-suave); margin: 18px 0 0; max-width: 46ch; }
  .aviso-repetida {
    padding: 10px 16px;
    border: 1px solid color-mix(in srgb, var(--oro) 45%, transparent);
    border-radius: var(--radio);
    color: var(--oro-claro);
    max-width: 52ch;
  }
  @media (prefers-reduced-motion: no-preference) {
    .giro.girada + .respuesta { animation: subir 0.9s 0.5s var(--ease) both; }
  }
  @keyframes subir { from { opacity: 0; transform: translateY(16px); } }
  @media (prefers-reduced-motion: reduce) { .giro { transition: none; } }
  @media (max-width: 760px) {
    .mesa { padding: 40px 0 64px; }
    .resultado { grid-template-columns: 1fr; gap: 36px; justify-items: center; text-align: center; }
    .giro { width: 200px; }
    .consejo { border-left: 0; padding-left: 0; }
    .nota { margin-inline: auto; }
    .acciones { justify-content: center; }
  }

  .contenido { padding: 96px 0 96px; }
  .estrecho { max-width: 760px; }
  .faq-titulo { margin-top: 1.4em; }
  details { border-top: 1px solid rgba(43, 26, 44, 0.15); padding: 18px 0; }
  details:last-of-type { border-bottom: 1px solid rgba(43, 26, 44, 0.15); }
  summary { cursor: pointer; font-size: 1.1rem; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  summary::after { content: '+'; color: var(--terracota); font-size: 1.4rem; line-height: 1; transition: transform 0.3s var(--ease); }
  details[open] summary::after { transform: rotate(45deg); }
  summary::-webkit-details-marker { display: none; }
  details p { margin: 12px 0 0; }
</style>
