---
import Base from '../layouts/Base.astro';
import Carta from '../components/Carta.astro';
import SelectorBaraja from '../components/SelectorBaraja.astro';
import Explicacion from '../components/Explicacion.astro';
import { arcanos } from '../data/arcanos';
import { lecturas } from '../data/lecturas';

const datos = arcanos.map((a) => ({
  slug: a.slug,
  romano: a.romano,
  nombre: a.nombre,
  consejo: a.consejo,
  dia: lecturas[a.slug].dia,
}));

const faq = [
  {
    p: '¿Qué es la carta del día?',
    r: 'Es una sola carta que sacas por la mañana para orientar tu jornada. No predice lo que va a pasar: te propone una actitud o algo en lo que fijarte hoy.',
  },
  {
    p: '¿Puedo sacar otra si no me gusta?',
    r: 'Tu carta se queda guardada en este navegador hasta medianoche, para que puedas volver a leerla. Mañana tendrás una nueva.',
  },
  {
    p: '¿Es gratis?',
    r: 'Sí, cada día y sin registro. Solo guardamos en tu propio navegador qué carta te salió hoy.',
  },
];
---

<Base
  title="Carta del día: tu tarot diario gratis | Noctámbula"
  description="Saca tu carta del día del tarot gratis: un arcano mayor y un mensaje para orientar tu jornada. Una carta nueva cada día, sin registro."
>
  <section class="mesa">
    <div class="contenedor diario">
      <div class="lado-carta">
        <button class="giro" id="giro" type="button" aria-label="Descubrir tu carta del día">
          <span class="cara dorso"></span>
          <span class="cara frente" id="frente"></span>
        </button>
        <p class="pista" id="pista">Toca la carta para darle la vuelta</p>
      </div>

      <div class="lado-texto">
        <p class="antetitulo" id="fecha">Hoy</p>
        <h1>La carta <em>del día</em></h1>
        <div id="antes">
          <p class="sub">Respira, piensa en el día que tienes por delante y descubre tu carta. Te acompañará hasta medianoche.</p>
          <button class="boton" id="descubrir" type="button">Descubrir mi carta</button>
          <div class="elegir-baraja"><SelectorBaraja /></div>
        </div>
        <div id="despues" hidden>
          <a class="carta-titulo" id="nombre" href="/cartas/"></a>
          <p class="mensaje" id="mensaje"></p>
          <p class="consejo"><span>Para hoy</span> <span id="consejo"></span></p>
          <div class="acciones">
            <a class="boton" href="/tarot-del-amor/">Tarot del amor</a>
            <a class="enlace-flecha" href="/tiradas/">Otras tiradas</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {arcanos.map((a) => <template id={`carta-${a.slug}`}><Carta arcano={a} /></template>)}

  <Explicacion titulo="Cómo usar tu carta del día" faq={faq}>
    <p class="suave">
      Sácala por la mañana y léela con calma. Durante el día, fíjate en si aparece lo que la carta propone: una
      conversación, una decisión pequeña, un momento para ti. Por la noche, vuelve a leerla. Muchas veces se entiende
      mejor al final del día.
    </p>
  </Explicacion>
</Base>

<script is:inline define:vars={{ datos }}>
  const $ = (id) => document.getElementById(id);
  const hoy = new Date();
  const clave = `carta-del-dia-${hoy.getFullYear()}-${hoy.getMonth() + 1}-${hoy.getDate()}`;
  $('fecha').textContent = hoy.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });

  const elegir = () => {
    try {
      const guardada = datos.find((d) => d.slug === localStorage.getItem(clave));
      if (guardada) return guardada;
    } catch (e) {}
    const u = new Uint32Array(1);
    crypto.getRandomValues(u);
    const carta = datos[u[0] % datos.length];
    try {
      Object.keys(localStorage)
        .filter((k) => k.startsWith('carta-del-dia-'))
        .forEach((k) => localStorage.removeItem(k));
      localStorage.setItem(clave, carta.slug);
    } catch (e) {}
    return carta;
  };

  let vista = false;
  const descubrir = () => {
    if (vista) return;
    vista = true;
    const carta = elegir();
    $('frente').replaceChildren($(`carta-${carta.slug}`).content.cloneNode(true));
    $('nombre').textContent = `${carta.romano}. ${carta.nombre}`;
    $('nombre').href = `/cartas/${carta.slug}/`;
    $('mensaje').textContent = carta.dia;
    $('consejo').textContent = carta.consejo;
    $('giro').classList.add('girada');
    $('giro').setAttribute('aria-label', `${carta.romano}. ${carta.nombre}`);
    $('pista').hidden = true;
    $('antes').hidden = true;
    $('despues').hidden = false;
  };

  $('giro').addEventListener('click', descubrir);
  $('descubrir').addEventListener('click', descubrir);
  try {
    if (localStorage.getItem(clave)) descubrir();
  } catch (e) {}
</script>

<style>
  .mesa {
    padding: 80px 0 96px;
    min-height: calc(100dvh - 68px);
    background: radial-gradient(60% 70% at 25% 40%, rgba(46, 76, 140, 0.35), transparent 70%),
      radial-gradient(60% 60% at 70% 30%, rgba(77, 42, 96, 0.5), transparent 70%);
  }
  .diario {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 96px;
    align-items: center;
    max-width: 1000px;
  }
  .lado-carta { display: grid; justify-items: center; gap: 18px; }
  .giro {
    width: 300px;
    aspect-ratio: 7 / 12;
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform-style: preserve-3d;
    transition: transform 1.1s var(--ease);
  }
  .giro:not(.girada):hover { transform: translateY(-8px); }
  .giro:focus-visible { outline: 2px solid var(--oro-claro); outline-offset: 6px; }
  .giro.girada { transform: rotateY(180deg); cursor: default; }
  .cara { position: absolute; inset: 0; display: block; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .frente { transform: rotateY(180deg); }
  .frente :global(.carta) { max-width: none; height: 100%; }
  .pista { font-size: 0.9rem; color: var(--texto-suave); margin: 0; }
  .lado-texto .antetitulo::first-letter { text-transform: uppercase; }
  .sub { font-size: 1.15rem; color: var(--texto-suave); max-width: 46ch; margin-bottom: 32px; }
  .elegir-baraja { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--linea-suave); }
  .carta-titulo {
    display: inline-block;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--oro);
    text-decoration: none;
    margin-top: 8px;
  }
  .carta-titulo:hover { color: var(--oro-claro); }
  .mensaje { font-family: var(--serif); font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.3; margin: 16px 0 28px; max-width: 30ch; }
  .consejo { border-left: 1px solid var(--oro); padding-left: 18px; color: var(--texto-suave); max-width: 52ch; }
  .consejo span:first-child { color: var(--texto); font-weight: 600; margin-right: 6px; }
  .acciones { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 32px; }
  @media (prefers-reduced-motion: no-preference) {
    #despues:not([hidden]) { animation: subir 0.9s 0.6s var(--ease) both; }
  }
  @keyframes subir { from { opacity: 0; transform: translateY(16px); } }
  @media (prefers-reduced-motion: reduce) { .giro { transition: none; } }
  @media (max-width: 820px) {
    .mesa { padding: 40px 0 64px; }
    .diario { grid-template-columns: 1fr; gap: 36px; }
    .giro { width: 210px; }
  }
</style>
