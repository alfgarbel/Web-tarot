---
import Base from '../../layouts/Base.astro';
import { arcanos } from '../../data/arcanos';
import { signos, nombreElemento } from '../../data/signos';
import { fechaMadrid, repartoDelDia } from '../../data/horoscopo';

const nombres = arcanos.map((a) => a.nombre);
const reparto = repartoDelDia(fechaMadrid(new Date()));
---

<Base
  title="Horóscopo de hoy con el tarot: los 12 signos | Arcanaia"
  description="Horóscopo diario gratis para los 12 signos del zodiaco: cada día una carta del tarot para tu signo, con su mensaje para el amor, el trabajo y la salud."
>
  <section class="cabeza contenedor">
    <p class="antetitulo" id="fecha">Hoy</p>
    <h1>Horóscopo <em>de hoy</em></h1>
    <p class="sub">Cada día, una carta del tarot por signo. Busca el tuyo y lee qué te toca hoy en el amor, en el trabajo y con la salud.</p>
  </section>

  <section class="contenedor zona">
    <ul class="rejilla">
      {
        signos.map((s) => (
          <li>
            <a href={`/horoscopo/${s.slug}/`}>
              <span class="nombre">{s.nombre}</span>
              <span class="datos">{s.fechas} · {nombreElemento(s.elemento)}</span>
              <span class="hoy" data-signo={s.slug}>{nombres[reparto[signos.indexOf(s)]]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script type="application/json" id="datos-horoscopo" set:html={JSON.stringify(nombres)} />

<script>
  import { fechaMadrid, repartoDelDia } from '../../data/horoscopo';

  const nombres: string[] = JSON.parse(document.getElementById('datos-horoscopo')!.textContent!);
  const reparto = repartoDelDia(fechaMadrid(new Date()));
  document.getElementById('fecha')!.textContent = new Date().toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Madrid' });
  document.querySelectorAll<HTMLElement>('[data-signo]').forEach((el, i) => (el.textContent = nombres[reparto[i]]));
</script>

<style>
  .cabeza { padding-top: 72px; padding-bottom: 40px; }
  .antetitulo::first-letter { text-transform: uppercase; }
  .sub { font-size: 1.2rem; color: var(--texto-suave); max-width: 58ch; }
  .zona { padding-bottom: 96px; }
  .rejilla { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0 32px; }
  .rejilla a { display: grid; gap: 4px; padding: 20px 0; border-bottom: 1px solid var(--linea-suave); text-decoration: none; color: var(--texto); }
  .nombre { font-family: var(--serif); font-size: 1.5rem; }
  .datos { font-size: 0.85rem; color: var(--texto-suave); }
  .hoy { font-family: var(--serif); font-style: italic; color: var(--oro); min-height: 1.4em; }
  .rejilla a:hover .nombre { color: var(--oro-claro); }
  @media (max-width: 960px) { .rejilla { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .rejilla { grid-template-columns: 1fr; } }
</style>
