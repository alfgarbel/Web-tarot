---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/portada.webp' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const ruta = Astro.url.pathname;
const enlaces = [
  { href: '/tarot-si-o-no/', texto: 'Tarot Sí o No' },
  { href: '/cartas/', texto: 'Los arcanos' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Noctámbula" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#170c20" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const b = localStorage.getItem('baraja');
        if (b) document.documentElement.dataset.baraja = b;
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor fila">
        <a href="/" class="marca" aria-label="Noctámbula, inicio">Noctámbula</a>
        <nav aria-label="Principal">
          {
            enlaces.map((e) => (
              <a href={e.href} aria-current={ruta.startsWith(e.href) ? 'page' : undefined}>
                {e.texto}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor">
        <div class="pie-fila">
          <p class="marca-pie">Noctámbula</p>
          <nav aria-label="Pie">
            <a href="/tarot-si-o-no/">Tarot Sí o No</a>
            <a href="/cartas/">Los 22 arcanos</a>
            <a href="/aviso-legal/">Aviso legal</a>
          </nav>
        </div>
        <p class="aviso">
          Las lecturas son una herramienta de reflexión y entretenimiento. No sustituyen el consejo de profesionales de la
          salud, el derecho o las finanzas.
        </p>
      </div>
    </footer>

    <script>
      const io = new IntersectionObserver(
        (entradas) =>
          entradas.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.revelar').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(23, 12, 32, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--linea-suave);
  }
  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 16px;
  }
  .marca {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--texto);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  nav { display: flex; gap: 28px; }
  .cabecera nav a {
    color: var(--texto-suave);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.3s;
  }
  .cabecera nav a:hover,
  .cabecera nav a[aria-current='page'] { color: var(--oro-claro); }
  @media (max-width: 520px) {
    .marca { font-size: 1.35rem; }
    nav { gap: 16px; }
    .cabecera nav a { font-size: 0.88rem; }
  }

  .pie {
    border-top: 1px solid var(--linea-suave);
    padding: 56px 0 40px;
    margin-top: 40px;
  }
  .pie-fila {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .marca-pie { font-family: var(--serif); font-style: italic; font-size: 2.4rem; margin: 0; }
  .pie nav a { color: var(--texto-suave); text-decoration: none; font-size: 0.95rem; }
  .pie nav a:hover { color: var(--oro-claro); }
  .aviso { font-size: 0.85rem; color: var(--texto-suave); max-width: 70ch; margin: 0; }
</style>
