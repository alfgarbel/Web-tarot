---
import { existsSync } from 'node:fs';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Ruta de migas para los datos estructurados: [{ nombre, url }], sin incluir la portada. */
  migas?: { nombre: string; url: string }[];
}

const { title: tituloPedido, description: descripcionPedida, image: imagenPedida, migas } = Astro.props;
// Cada página tiene su imagen para compartir en public/og/ (se generan con OGsmith, ver scripts/og/).
const rutaOg = `/og/${Astro.url.pathname === '/' ? 'inicio' : Astro.url.pathname.replace(/^\/|\/$/g, '')}.jpg`;
const image = imagenPedida ?? (existsSync(`public${rutaOg}`) ? rutaOg : '/portada.webp');
// Google corta los títulos hacia los 60 caracteres y las descripciones hacia los 160.
const title = tituloPedido.length > 65 ? tituloPedido.replace(/ \| Arcanaia$/, '') : tituloPedido;
const recortar = (t: string, max: number) => {
  if (t.length <= max) return t;
  const corte = t.slice(0, max - 1);
  return corte.slice(0, corte.lastIndexOf(' ')).replace(/[,.:;]$/, '') + '…';
};
const description = recortar(descripcionPedida, 160);
const esPortada = Astro.url.pathname === '/';
const sitio = new URL('/', Astro.site).href;
const datosSitio = esPortada
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        { '@type': 'WebSite', '@id': `${sitio}#web`, url: sitio, name: 'Arcanaia', inLanguage: 'es-ES', publisher: { '@id': `${sitio}#org` } },
        { '@type': 'Organization', '@id': `${sitio}#org`, name: 'Arcanaia', url: sitio, logo: new URL('/favicon.svg', Astro.site).href },
      ],
    }
  : null;
const datosMigas = migas
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ nombre: 'Inicio', url: '/' }, ...migas].map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: m.nombre,
        item: new URL(m.url, Astro.site).href,
      })),
    }
  : null;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const ruta = Astro.url.pathname;
const enlaces = [
  { href: '/tiradas/', texto: 'Tiradas', tambien: ['/tarot-si-o-no/', '/tarot-del-amor/', '/volvera-mi-ex/', '/pasado-presente-futuro/', '/cruz-celta/', '/carta-del-dia/', '/tarot-del-trabajo/', '/tarot-de-la-salud/', '/dos-caminos/'] },
  { href: '/signos/', texto: 'Signos', tambien: ['/compatibilidad/', '/horoscopo/'] },
  { href: '/cartas/', texto: 'Los arcanos', corto: 'Arcanos', tambien: ['/combinaciones/'] },
  { href: '/aprender-tarot/', texto: 'Aprender', tambien: [] },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arcanaia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {image.endsWith('.jpg') && <meta property="og:image:width" content="1200" />}
    {image.endsWith('.jpg') && <meta property="og:image:height" content="630" />}
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#170c20" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const b = localStorage.getItem('baraja');
        if (b) document.documentElement.dataset.baraja = b;
      } catch (e) {}
      // Recuerda cada lectura en este navegador para que repetir la misma pregunta dé la misma respuesta.
      window.memoriaTirada = (() => {
        const CLAVE = 'arcanaia-lecturas';
        const DIA = 24 * 60 * 60 * 1000;
        const RATO = 60 * 60 * 1000;
        const normalizar = (t) =>
          t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9ñ ]/g, ' ').replace(/\s+/g, ' ').trim();
        const cargar = () => {
          try {
            const todo = JSON.parse(localStorage.getItem(CLAVE) || '{}');
            const ahora = Date.now();
            for (const k in todo) if (todo[k].hasta < ahora) delete todo[k];
            return todo;
          } catch (e) {
            return {};
          }
        };
        return {
          leer(tirada, pregunta) {
            return cargar()[tirada + '|' + normalizar(pregunta)] || null;
          },
          guardar(tirada, pregunta, cartas) {
            try {
              const todo = cargar();
              const p = normalizar(pregunta);
              todo[tirada + '|' + p] = { cartas, hasta: Date.now() + (p ? DIA : RATO) };
              localStorage.setItem(CLAVE, JSON.stringify(todo));
            } catch (e) {}
          },
        };
      })();
    </script>
    {datosSitio && <script type="application/ld+json" set:html={JSON.stringify(datosSitio)} />}
    {datosMigas && <script type="application/ld+json" set:html={JSON.stringify(datosMigas)} />}
    <slot name="head" />
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor fila">
        <a href="/" class="marca" aria-label="Arcanaia, inicio">Arcanaia</a>
        <nav aria-label="Principal">
          {
            enlaces.map((e) => (
              <a href={e.href} aria-current={[e.href, ...e.tambien].some((r) => ruta.startsWith(r)) ? 'page' : undefined}>
                {e.corto ? <><span class="nav-largo">{e.texto}</span><span class="nav-corto">{e.corto}</span></> : e.texto}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor">
        <div class="pie-fila">
          <p class="marca-pie">Arcanaia</p>
          <nav aria-label="Pie">
            <a href="/tarot-del-amor/">Tarot del amor</a>
            <a href="/volvera-mi-ex/">¿Volverá mi ex?</a>
            <a href="/tarot-si-o-no/">Tarot Sí o No</a>
            <a href="/pasado-presente-futuro/">Pasado, presente y futuro</a>
            <a href="/cruz-celta/">Cruz celta</a>
            <a href="/tarot-del-trabajo/">Trabajo y dinero</a>
            <a href="/tarot-de-la-salud/">Salud y bienestar</a>
            <a href="/dos-caminos/">Decidir entre dos caminos</a>
            <a href="/carta-del-dia/">Carta del día</a>
            <a href="/compatibilidad/">Compatibilidad de signos</a>
            <a href="/horoscopo/">Horóscopo de hoy</a>
            <a href="/signos/">Los 12 signos</a>
            <a href="/cartas/">Las 78 cartas</a>
            <a href="/combinaciones/">Combinaciones de cartas</a>
            <a href="/aprender-tarot/">Aprender tarot</a>
            <a href="/aviso-legal/">Aviso legal</a>
          </nav>
        </div>
        <p class="aviso">
          Las lecturas son una herramienta de reflexión y entretenimiento. No sustituyen el consejo de profesionales de la
          salud, el derecho o las finanzas.
        </p>
      </div>
    </footer>

    <script>
      const io = new IntersectionObserver(
        (entradas) =>
          entradas.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.revelar').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(23, 12, 32, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--linea-suave);
  }
  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 16px;
  }
  .marca {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--texto);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  nav { display: flex; gap: 28px; }
  .cabecera nav a {
    color: var(--texto-suave);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.3s;
  }
  .nav-corto { display: none; }
  .cabecera nav a:hover,
  .cabecera nav a[aria-current='page'] { color: var(--oro-claro); }
  @media (max-width: 520px) {
    .marca { font-size: 1.35rem; }
    nav { gap: 14px; }
    .cabecera nav a { font-size: 0.88rem; }
    .nav-largo { display: none; }
    .nav-corto { display: inline; }
  }

  .pie {
    border-top: 1px solid var(--linea-suave);
    padding: 56px 0 40px;
    margin-top: 40px;
  }
  .pie-fila {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .marca-pie { font-family: var(--serif); font-style: italic; font-size: 2.4rem; margin: 0; }
  .pie nav { flex-wrap: wrap; gap: 12px 28px; }
  .pie nav a { color: var(--texto-suave); text-decoration: none; font-size: 0.95rem; }
  .pie nav a:hover { color: var(--oro-claro); }
  .aviso { font-size: 0.85rem; color: var(--texto-suave); max-width: 70ch; margin: 0; }
</style>
